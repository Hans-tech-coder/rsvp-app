# Firebase Client Config
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin Config (Keep these secure on the server)
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# Vercel Blob (image uploads). Added automatically on Vercel when the Blob store
# is connected to the project; pull it locally with `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=""

# Gmail used to send guests their RSVP confirmation email.
# GMAIL_USER is the full Gmail address; GMAIL_APP_PASSWORD is its 16-character
# App Password (Google Account > Security > App passwords), not the login password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Optional. The event `/` redirects to and the admin edits (default: hans-and-czay).
NEXT_PUBLIC_DEFAULT_EVENT_ID=""
# Optional. Public address used in link previews, invite messages and emails.
# On Vercel the production domain is used when this is empty; set it for a custom domain.
NEXT_PUBLIC_SITE_URL=""
