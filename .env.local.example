# Vercel Blob (image uploads). Added automatically on Vercel when the Blob store
# is connected to the project; pull it locally with `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=""

# Gmail used to send guests their RSVP confirmation email.
# GMAIL_USER is the full Gmail address; GMAIL_APP_PASSWORD is its 16-character
# App Password (Google Account > Security > App passwords), not the login password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
