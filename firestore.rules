rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the current user is an admin by looking up their UID in the admins collection
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins Collection: Only readable by the authenticated user to verify their own admin status.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Only manageable from Firebase Console natively for now
    }

    // Admin allowlist (pending admins, keyed by lowercased email): server only.
    // Written by scripts/add-admin.js, claimed by createSessionCookie.
    match /adminAllowlist/{email} {
      allow read, write: if false;
    }

    // Guests Collection: holds guest PII. Code checks, RSVPs and admin views all
    // go through server actions / server pages with firebase-admin, which bypasses rules.
    match /guests/{inviteCode} {
      allow read, write: if false; // server-only via firebase-admin
    }

    // Registry Gifts Collection
    match /registryGifts/{giftId} {
      allow read, write: if isAdmin();
      
      // Public can read to browse gifts on the landing page
      allow read: if true; 
      
      // Writes disabled from client. Handled by Server Action.
      allow write: if false;
    }

    // Gift Selections Collection
    match /giftSelections/{selectionId} {
      allow read, write: if isAdmin();
      
      // Public cannot read who selected what
      allow read: if false;
      
      // Writes disabled from client. Handled by Server Action.
      allow write: if false;
    }

    // Website Content Collection (Images/Text overrides)
    match /websiteContent/{document=**} {
      allow read: if true; // Public can read content
      allow write: if isAdmin(); // Only admins can edit content
    }

    // ---- Event-scoped data (F3). The root collections above are the old
    // shape: kept until the copy under events/ is verified, then removed.
    // Paths are built in src/lib/eventPaths.ts.
    match /events/{eventId} {
      // Event record (slug, type, status): read and written by the server only.
      allow read, write: if false;

      // Screen text and images: public read, admins edit from the browser.
      match /content/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Guest PII: server only (firebase-admin bypasses rules).
      match /guests/{inviteCode} {
        allow read, write: if false;
      }

      // Gifts: public read; writes through server actions only.
      match /registryGifts/{giftId} {
        allow read: if true;
        allow write: if false;
      }

      // Who claimed what: admins may read; writes through server actions only.
      match /giftSelections/{selectionId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // Invite template etc.: server only.
      match /settings/{docId} {
        allow read, write: if false;
      }
    }
  }
}
